# ─── Database ───────────────────────────────────────────────────────────────
# Used by Prisma. Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://heimdall:your_secure_password@localhost:5432/heimdall_db"

# Used by Docker Compose to set the Postgres container password
POSTGRES_PASSWORD="your_secure_password"

# ─── JWT ────────────────────────────────────────────────────────────────────
# 64+ random chars. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="replace_with_64_random_chars"

# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3000
